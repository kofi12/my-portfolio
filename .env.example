# Public scheduling page for every "Book a free call" button.
# When this is an http(s) link, the button opens it in a new tab.
# When it is empty, the button falls back to email.
# Google Calendar appointment schedule or Cal.com both work. Do not paste an iframe snippet.
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-name/intro

# Resend API key for the on-site app-audit form.
# Create a free account at https://resend.com and copy the API key.
# Until a domain is verified, Resend only delivers from onboarding@resend.dev
# and only to the email address on that Resend account. Use the same address
# you can read, or verify a domain and set RESEND_FROM to an address on it.
# RESEND_API_KEY=re_xxxxxxxx

# Optional sender. Defaults to onboarding@resend.dev.
# RESEND_FROM=onboarding@resend.dev
